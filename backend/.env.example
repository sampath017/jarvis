# ── Google Places API ────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ── OpenRouter LLM Configuration ─────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=z-ai/glm-5.3-flash
LLM_OUTPUT_TOKENS=16384


# Keep the existing Chroma Cloud configuration and embedding service.
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your-existing-key
CHROMA_TENANT=your-existing-tenant
CHROMA_DATABASE=your-existing-database
EMBEDDING_URL=https://your-existing-embedding-service

# ── Firebase Configuration ───────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Google Places API ────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ── OpenRouter LLM Configuration ─────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL_TIER1=qwen/qwen-2.5-7b-instruct
OPENROUTER_MODEL_TIER2=qwen/qwen-2.5-72b-instruct

# ── LangSmith / LangChain Tracing ───────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT="Jarvis"

# ── Chroma Cloud & Vector Search ───────────────────────────────────────────
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant-id
CHROMA_DATABASE=jarvis-drive

EMBEDDING_URL=https://jarvis-embedding-your-hash-uc.a.run.app
INDEX_STAGING_BUCKET=jarvis-drive-index-staging-your-project
